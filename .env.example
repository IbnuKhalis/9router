# =====================================================================
# 9Router Environment Configuration Template
# Salin berkas ini ke .env sebelum menjalankan docker-compose:
#   PowerShell: .\execution\init-env.ps1  (otomatis aman UTF-8 No BOM)
# =====================================================================

# --- Pengaturan Inti & Keamanan Dashboard ---
# Ganti dengan string acak yang panjang dan aman (minimal 32 karakter)
# Digunakan untuk menandatangani session JWT dashboard web
JWT_SECRET=ganti-dengan-string-acak-panjang-dan-aman

# Password untuk login admin pertama kali ke dashboard
# CATATAN: Jika dikosongkan, nilai default bawaan upstream 9router adalah: 123456
INITIAL_PASSWORD=ganti-dengan-password-admin-anda

# Direktori penyimpanan data (di dalam container Docker)
DATA_DIR=/app/data

# --- Pengaturan Port & Host ---
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production

# --- Keamanan Endpoint & API Key (/v1/*) ---
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt

# Atur 'true' saat di VPS publik agar endpoint /v1 wajib menyertakan Bearer API Key
# Di lingkungan lokal workstation, dapat bernilai 'false' untuk kemudahan pengujian
REQUIRE_API_KEY=false

# Atur 'true' jika sudah berjalan di balik HTTPS/SSL di VPS (Caddy reverse proxy)
AUTH_COOKIE_SECURE=false

# --- Logging & Observability ---
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true

# --- Base URL ---
# Lokal: http://localhost:20128
# VPS:   https://router.digitalneeds.my.id
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# --- Optional Headroom Token Saver Sidecar ---
# Aktifkan jika mengaktifkan service headroom di docker-compose
# HEADROOM_URL=http://headroom:8787

